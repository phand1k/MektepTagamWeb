@model MektepTagamWeb.Models.CreditToBalance

<h4>Создание карточки ученика</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="AddToBalance">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="IndividualNumberPerson" class="control-label"></label>
                <input asp-for="IndividualNumberPerson" class="form-control" />
                <span asp-validation-for="IndividualNumberPerson" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Ammount" class="control-label"></label>
                <input asp-for="Ammount" class="form-control" />
                <span asp-validation-for="Ammount" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Создать" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="CardCodes">Список транзакций</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
